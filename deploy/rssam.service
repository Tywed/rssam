[Unit]
Description=rssam RSS aggregator
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=rssam
Group=rssam
WorkingDirectory=/opt/rssam
EnvironmentFile=/opt/rssam/.env
ExecStart=/opt/rssam/bin/rssam
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# --- Sandbox -----------------------------------------------------------------
# The process needs outbound TCP (feeds, webhooks, PostgreSQL), read access to
# /opt/rssam and write access to exactly: its log and backup directories, the
# request directory for restart/update (see rssam-ops.path) and the .env file
# (settings saved from the admin UI; rewritten in place). /opt/rssam itself
# and /opt/rssam/bin are root-owned and read-only for the service, so a
# compromised process cannot swap the binary that systemd starts next time.
# Restart and update from the UI go through a request file picked up by the
# root-owned rssam-ops.path unit, so the service never needs to gain
# privileges and NoNewPrivileges= holds.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/rssam/log /opt/rssam/backups /opt/rssam/run /opt/rssam/.env
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
