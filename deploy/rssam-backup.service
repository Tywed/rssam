[Unit]
Description=rssam database backup
After=postgresql.service

[Service]
Type=oneshot
User=rssam
Group=rssam
EnvironmentFile=/opt/rssam/.env
ExecStart=/usr/local/sbin/rssam-backup backup
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=/opt/rssam/backups
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
