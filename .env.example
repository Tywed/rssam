# Copy to .env and adjust for local dev: cp .env.example .env
# Required
DATABASE_URL=postgres://rssam:rssam@localhost:5432/rssam?sslmode=disable

# HTTP server
LISTEN_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
RUN_MIGRATIONS=true

# Entry storage: full (default) | dedup_only (hash/url only for non-matches; strip body after webhook)
# STORE_ENTRIES_MODE=dedup_only
# DEDUP_ONLY_STORAGE=true

# Web UI (SSR). Set true to serve /ui
UI_ENABLED=true

# Auth. AUTH_TOKEN is a single shared bearer token that authenticates as the
# first user with full admin rights — for local development only; in
# production leave it empty (UI login + per-user API keys with read/write/admin
# scope and expiry). Deprecated: logs a warning at start, removed in 0.2.0.
# The placeholder value "dev-token" is refused at start unless ALLOW_DEV_TOKEN=true.
AUTH_TOKEN=
# ALLOW_DEV_TOKEN=true
METRICS_TOKEN=dev-metrics-token
# Generated automatically if AUTH_TOKEN and METRICS_TOKEN are empty
# CSRF_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Max Channel bridge (feed_type=max, https://max.ru/{channel}) ---
# Base URL of a Max Channel HTTP API (RSS-Bridge compatible). Leave empty if unused.
# MAX_API_BASE_URL=http://127.0.0.1:8000
# Messages per poll (1–200)
MAX_DEFAULT_LIMIT=100
# First poll without cursor; Go duration (24h, 2m) — not raw milliseconds
MAX_DEFAULT_LOOKBACK_MS=24h
# Overlap for incremental after= (subtract from last end time)
MAX_OVERLAP_MS=2m
# Pause after HTTP 429 from Max API (seconds) — applies to ALL Max feeds
MAX_RATE_LIMIT_SECONDS=60
# Min delay between Max API HTTP calls (milliseconds). 0 = serialize only, no extra delay.
MAX_REQUEST_INTERVAL_MS=1000
# Parallel Max API requests (1–32). 1 is safest for a small local API.
MAX_CONCURRENT_SLOTS=1
# Allow private/LAN IP for MAX_API_BASE_URL (or use FETCH_ALLOW_PRIVATE_NETWORK)
# MAX_ALLOW_PRIVATE_API=true

# --- Telegram bridge (feed_type=telegram, https://t.me/s/{username}) ---
# Required for polling Telegram: external proxy-service (GET /proxy, POST /proxy/bad)
# TELEGRAM_PROXY_SERVICE_URL=http://127.0.0.1:8787
# TELEGRAM_PROXY_SERVICE_TOKEN=
# TELEGRAM_STATIC_PROXY=127.0.0.1:1080
# Optional: default ?target= when requesting a proxy slot
# TELEGRAM_PROXY_TARGET_URL=
TELEGRAM_PROXY_CONNECT_TIMEOUT=10s
TELEGRAM_PROXY_REQUEST_TIMEOUT=25s
# Extra attempts with a new proxy after report bad (0–20)
TELEGRAM_PROXY_RETRY=1
# History pages via ?before= pagination (1–100)
TELEGRAM_MAX_PAGES=1
# Parallel channel fetches through the proxy (1–32); the rest wait for a slot
TELEGRAM_CONCURRENT_SLOTS=4

# SSRF: allow private networks for Max API / proxy-service (dev / LAN only)
FETCH_ALLOW_PRIVATE_NETWORK=false
# Per-feed TLS skip: enable «Не проверять сертификат» on the feed form for RF CA sites.
# Global override (disables verify for ALL fetches — prefer per-feed instead):
# FETCH_TLS_INSECURE=true

# --- VK Search bridge (feed_type=vk_search) ---
# Bearer token for newsfeed.search (never commit real tokens)
# VK_ACCESS_TOKEN=
# VK_API_VERSION=5.199
# VK_DEFAULT_COUNT=100
# VK_DEFAULT_LOOKBACK=24h
# VK_OVERLAP=2m
# VK_RATE_LIMIT_SECONDS=5

# --- MaxStat search bridge (feed_type=maxstat, https://maxstat.ru/posts?search=...) ---
# Per-feed API token: feeds.bridge_state → {"maxstat":{"api_token":"..."}} (like RSS-Bridge)
# Optional global fallback if a feed has no api_token:
# MAXSTAT_ACCESS_TOKEN=
# MAXSTAT_API_BASE_URL=https://maxstat.ru/api/v1
# MAXSTAT_DEFAULT_LIMIT=100
# MAXSTAT_DEFAULT_LOOKBACK=24h
# MAXSTAT_OVERLAP=2m
# Pause after HTTP 429 (seconds, default 30m)
# MAXSTAT_RATE_LIMIT_SECONDS=1800

# Optional: GitHub repo for UI version badge (owner/name)
# GITHUB_REPO=Tywed/rssam
# RSSAM_ENV_FILE=/opt/rssam/.env

# WORKER_POOL_SIZE=10
# WEBHOOK_WORKER_POOL_SIZE=10
# Retention (auto-cleanup runs every CLEANUP_INTERVAL; editable in UI → Система):
# removed entries / webhook delivery logs / filter matches / per-feed poll log
# (0 = keep forever for filter matches and poll log).
# Webhook delivery counters do not depend on the logs and survive the cleanup.
# REMOVED_RETENTION_DAYS=30
# WEBHOOK_LOG_RETENTION_DAYS=90
# FILTER_MATCH_RETENTION_DAYS=90
# FEED_POLL_LOG_RETENTION_DAYS=14
# CLEANUP_INTERVAL=24h
# Postgres pool size (0 = auto from worker pools + HTTP headroom)
# DATABASE_MAX_CONNS=0
# MIN_POLL_INTERVAL=60s
# MAX_POLL_INTERVAL=24h

# Per-feed overrides (optional, in DB feeds.bridge_state JSON):
# {"telegram":{"proxy_service_url":"http://127.0.0.1:8787","max_pages":2}}
# {"max":{"last_end_time_ms":1234567890123}}
# {"maxstat":{"q":"example query","api_token":"..."}}

# --- Rutube bridge (feed_type=rutube, https://rutube.ru/video/person/{id}/) ---
# RUTUBE_API_BASE_URL=https://rutube.ru/api
# Per-feed: {"rutube":{"channel_id":"26119699"}}

# --- Dzen News bridge (feed_type=dzen_news) ---
# DZEN_SEARCH_URL=https://dzen.ru/news/search
# DZEN_USER_AGENT=Mozilla/5.0 ...  # по умолчанию Chrome desktop
# DZEN_COOKIE=zen_sso_checked=1    # обход SSO-редиректа dzen.ru
# Подписка: dzen-news://запрос или https://dzen.ru/news/search?text=...
# Per-feed: {"dzen_news":{"q":"python"}}

# Reverse proxies whose X-Forwarded-For / X-Real-IP may be trusted (CSV of IPs/CIDRs).
# Default: loopback only. Headers from any other peer are ignored (rate-limit / logs use the TCP peer).
# TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Per-IP limits (token bucket). RATE_LIMIT_* covers /v1 auth failures, refresh and
# webhook tests; LOGIN_RATE_LIMIT_* covers POST /ui/login only (default: 10 attempts,
# then one every 5 s per IP).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=20
# LOGIN_RATE_LIMIT_RPS=0.2
# LOGIN_RATE_LIMIT_BURST=10

# Set when the service is served over HTTPS (directly or via a reverse proxy):
# sends Strict-Transport-Security and marks the session cookie Secure.
# HSTS=true
# Sliding lifetime of a web UI session (cookie and DB row); 5m..8760h.
# SESSION_MAX_AGE=720h
